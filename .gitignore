# A local symlink into .agents/skills/ for Claude Code's own use — on
# Windows without symlink support, git stores this as duplicate file
# content instead of a link, so it's excluded rather than double-committed.
# .agents/skills/ is the real source; this regenerates via `npx skills`.
.claude/skills/
cleanup_backup_*.json
