# Copy to .env and fill in from Supabase dashboard → Project Settings → API
# .env is gitignored — never commit real values.

SUPABASE_URL=https://<project-ref>.supabase.co

# Project Settings → API → anon/public key. This backend uses it to call
# Supabase's Auth REST API (signup/login/refresh) on the user's behalf — the
# frontend never sees it, since the frontend never talks to Supabase directly.
SUPABASE_ANON_KEY=

# NOTE: this project uses Supabase's newer asymmetric JWT signing keys
# (ES256), not the legacy shared HS256 "JWT Secret" — access tokens are
# verified against the project's public JWKS (SUPABASE_URL + a fixed path,
# no separate secret needed). If this project ever shows a JWT Secret value
# that's a long random string rather than a UUID, it's on the legacy HS256
# scheme instead and app/auth.py's verify_access_token would need updating.

# Project Settings → API → service_role key
# Backend-only. Bypasses Row Level Security. Never send this to the client,
# never log it, never put it in a request the frontend can see. Not used by
# any endpoint yet in this pass — reserved for future admin tooling.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings → Database → Connection Pooling → "Session pooler" URI.
# NOT the direct db.<ref>.supabase.co host — that one is IPv6-only and will
# fail to resolve/connect on an IPv4-only network.
DATABASE_URL=

# "true" once this is ever served over HTTPS (production). Must stay "false"
# for local http://localhost dev — browsers refuse Secure cookies over plain http.
COOKIE_SECURE=false

# "lax" for local dev (frontend and backend are both "localhost", just
# different ports). Set to "none" in production once frontend and backend
# are on genuinely different domains (e.g. Netlify + Render) — cross-site
# fetches won't carry a Lax cookie at all. "none" REQUIRES COOKIE_SECURE=true;
# browsers reject SameSite=None cookies that aren't also Secure.
COOKIE_SAMESITE=lax

# Comma-separated allowed CORS origins. Defaults to the consumer app's local
# dev server if unset. In production, set this to the deployed frontend URL
# (e.g. https://your-app.netlify.app) — never a wildcard, incompatible with
# credentialed CORS anyway.
ALLOWED_ORIGINS=http://localhost:5173

# Push notifications (optional). Path to a Firebase service account key:
# Firebase console > Project settings > Service accounts > Generate new private key.
# Keep the file outside git. Without it, pushes are skipped and logged.
FIREBASE_SERVICE_ACCOUNT_FILE=
